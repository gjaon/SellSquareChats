# ─── Chatalog Environment Variables ──────────────────────────────────────────
#
# Copy this file to .env and fill in the correct value for your setup.
#
# Set EXPO_PUBLIC_API_URL to match how you're running the app:
#
#   Android emulator   →  http://10.0.2.2:4000
#   iOS simulator      →  http://localhost:4000
#   Physical device    →  http://<your-mac-lan-ip>:4000
#
# The backend must be running on port 4000 (cd SellSquare && npm run dev)
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
